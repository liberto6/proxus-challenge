{
  "name": "@proxus/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "agent:sum": "node --env-file=../../.env --import tsx src/scripts/agent-sum.ts",
    "agent:math": "node --env-file=../../.env --import tsx src/scripts/agent-math.ts",
    "agent:tutor": "node --env-file=../../.env --import tsx src/scripts/agent-tutor.ts",
    "dev": "node --env-file=../../.env --import tsx src/index.ts",
    "eval:tutor:artifact-authoring": "node --env-file=../../.env --import tsx src/evals/artifact-authoring.eval.ts",
    "eval:tutor:tool-calls": "node --import tsx src/evals/tool-calls.eval.ts",
    "eval:tutor:diagram": "node --env-file=../../.env --import tsx src/evals/diagram.eval.ts",
    "eval:tutor:explain": "node --import tsx src/evals/explain.eval.ts",
    "eval:tutor:grounding": "node --env-file=../../.env --import tsx src/evals/grounding.eval.ts",
    "eval:tutor:sessions": "node --import tsx src/evals/sessions.eval.ts",
    "eval:materials": "node --import tsx src/evals/materials.eval.ts",
    "eval:folders": "node --import tsx src/evals/folders.eval.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/ai-google": "workspace:*",
    "@effect/platform-node": "4.0.0-beta.83",
    "@proxus/shared": "workspace:*",
    "effect": "4.0.0-beta.83"
  }
}
